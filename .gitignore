# ===== Python / ml-pipeline =====
.venv/
.venv-tfjs/
__pycache__/
*.py[cod]
*.egg-info/

# ===== Node / mobile-app =====
node_modules/
dist/
*.local

# Capacitor natywne projekty (generowane)
mobile-app/android/
mobile-app/ios/

# ===== Dane (duże / zewnętrzne / wygenerowane) =====
# Trzymamy strukturę katalogów (.gitkeep), ale nie zawartość.
ml-pipeline/data/raw/*
ml-pipeline/data/processed/*
ml-pipeline/data/processed_5s/
ml-pipeline/models/
